APP_NAME=Med Robots API
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://medrobots:medrobots@db:5432/medrobots
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
LOG_LEVEL=INFO
# Connection pool tuning (PostgreSQL only; ignored for SQLite). Defaults shown.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
#
# Production example (real credentials/URL are set outside this file, never
# committed): ENVIRONMENT=production requires an explicit DATABASE_URL
# pointing at PostgreSQL and an HTTPS-only CORS_ORIGINS, e.g.:
# CORS_ORIGINS=https://www.medrobots.pt
